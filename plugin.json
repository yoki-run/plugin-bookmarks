{
  "$schema": "https://raw.githubusercontent.com/yoki-run/yoki/main/plugin.schema.json",
  "name": "Bookmarks",
  "keyword": "bm",
  "icon": "bookmark",
  "description": "Search Chrome, Edge, Brave, Vivaldi bookmarks instantly",
  "version": "1.1.0",
  "author": "Yoki",
  "homepage": "https://github.com/yoki-run/plugin-bookmarks",
  "license": "MIT",
  "categories": ["productivity", "tools"],
  "yoki_min": "1.0.9.2",

  "protocol": "v2",

  "permissions": {
    "filesystem": ["read:bookmarks"]
  },

  "commands": [
    {
      "name": "search",
      "title": "Search Bookmarks",
      "description": "Search across all browser bookmarks",
      "mode": "list",
      "exec": "search.rb",
      "takes_query": true
    }
  ]
}
